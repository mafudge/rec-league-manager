{
  "name": "rec-league-firebase-emulators",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix functions install",
    "emulators": "mkdir -p emulator-data && firebase emulators:start --project demo-rec-league --import=./emulator-data --export-on-exit=./emulator-data"
  },
  "devDependencies": {
    "firebase-tools": "^13.35.1"
  },
  "overrides": {
    "universal-analytics": {
      "uuid": "^8.3.2"
    }
  }
}
